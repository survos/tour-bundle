{
    "name": "survos/tour-bundle",
    "description": "Reusable translated tours for rendered menus and explicit Twig targets",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": [
        "symfony-ux",
        "tour",
        "driver.js"
    ],
    "require": {
        "php": "^8.5",
        "survos/kit-bundle": "^2.5",
        "symfony/config": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/http-kernel": "^8.1",
        "symfony/stimulus-bundle": "^2.0|^3.0",
        "symfony/translation": "^8.1",
        "symfony/twig-bundle": "^8.1",
        "symfony/ux-twig-component": "^3.0",
        "psr/log": "^3.0"
    },
    "suggest": {
        "survos/menu-bundle": "Automatic rendered menu annotations",
        "survos/field-bundle": "Opt-in compiled RouteMeta description fallback"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "symfony/asset-mapper": "^8.1",
        "symfony/browser-kit": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "Survos\\TourBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Survos\\TourBundle\\Tests\\": "tests/"
        }
    },
    "conflict": {
        "survos/menu-bundle": "<2.42.23",
        "survos/tabler-bundle": "<2.42.23"
    }
}
